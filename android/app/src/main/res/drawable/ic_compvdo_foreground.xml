<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon FOREGROUND layer.

    Canvas is 108x108dp but only the centre 72dp is guaranteed visible, and the
    66dp keyline circle is the practical safe zone. Every painted pixel below is
    kept inside radius ~36 of the centre (54,54), including the extra 3-4.5 added
    by the round stroke joins/caps, so no mask ever clips the mark.

    Design: a play triangle (video) squeezed between two heavy bars (compress).
    One idea, one colour, no strokes thinner than 6dp, no text, no fine detail.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Top compression bar -->
    <path
        android:pathData="M37,28 L71,28"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="9"
        android:strokeLineCap="round" />

    <!-- Bottom compression bar -->
    <path
        android:pathData="M37,80 L71,80"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="9"
        android:strokeLineCap="round" />

    <!-- Play triangle (stroked with its own fill colour to round the corners) -->
    <path
        android:pathData="M41,41 L41,67 L69,54 Z"
        android:fillColor="#FFFFFF"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineJoin="round"
        android:strokeLineCap="round" />
</vector>
