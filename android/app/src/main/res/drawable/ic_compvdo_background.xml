<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon BACKGROUND layer.
    Must fill the whole 108x108dp canvas: launchers mask it to a circle /
    squircle / rounded square, and anything short of full-bleed shows seams.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="38" android:endY="108"
                android:startColor="#29B6F6"
                android:endColor="#01579B" />
        </aapt:attr>
    </path>
</vector>
