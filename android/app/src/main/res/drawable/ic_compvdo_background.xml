<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon BACKGROUND layer.

    A flat light card, sampled from the supplied logo's own page colour, so the
    mark reads exactly as it was drawn. Must fill the whole 108x108dp canvas:
    launchers mask it to a circle / squircle / rounded square, and anything
    short of full-bleed shows a seam.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z"
        android:fillColor="@color/ic_launcher_background" />
</vector>
