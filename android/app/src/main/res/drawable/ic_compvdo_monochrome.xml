<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 13+ themed-icon MONOCHROME layer.

    Flat single-colour silhouette of the foreground, on transparency. The system
    tints the whole vector itself, so this must NOT carry an android:tint, in
    particular not ?attr/colorControlNormal, which this app cannot resolve
    because it does not use AppCompat.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M37,28 L71,28"
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="9"
        android:strokeLineCap="round" />

    <path
        android:pathData="M37,80 L71,80"
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="9"
        android:strokeLineCap="round" />

    <path
        android:pathData="M41,41 L41,67 L69,54 Z"
        android:fillColor="#FF000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="6"
        android:strokeLineJoin="round"
        android:strokeLineCap="round" />
</vector>
